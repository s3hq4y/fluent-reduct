{
  "name": "fluent-reduct",
  "productName": "Fluent Reduct",
  "version": "1.0.0-alpha.0",
  "description": "Fluent Reduct - a Fluent-style memory management application (fork of Mem Reduct)",
  "main": "dist/main/main.js",
  "author": "Henry++",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "build:main": "node scripts/build-main.js",
    "build:renderer": "node scripts/build-renderer.js",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "npm run build && node scripts/start.js",
    "dev": "node scripts/dev.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "clean": "node scripts/clean.js",
    "verify:i18n": "node scripts/verify-i18n.js",
    "verify:memory": "node scripts/verify-memory.js",
    "test:cleanup": "node scripts/test-cleanup.js"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "koffi": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2"
  }
}
