{
  "name": "fluent-reduct",
  "version": "1.0.0-alpha.0",
  "description": "Fluent Reduct - a Fluent-style memory management application (fork of Mem Reduct)",
  "main": "dist/main/main.js",
  "author": "Henry++",
  "license": "MIT",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json --outDir dist/main",
    "build:renderer": "tsc -p tsconfig.renderer.json && node scripts/build-renderer.js",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "start:dev": "concurrently \"tsc -w -p tsconfig.main.json\" \"tsc -w -p tsconfig.renderer.json\" \"sleep 2 && electron .\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "clean": "rm -rf dist release"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "koffi": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2"
  },
  "build": {
    "appId": "com.fluentreduct.app",
    "productName": "Fluent Reduct",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/ui/assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "fluent-reduct-portable-${version}.exe"
    }
  }
}
